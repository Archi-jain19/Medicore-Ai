# MediCore AI: production configuration for docker compose. Copy to `.env` and fill in every REQUIRED value.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# ---------------------------------------------------------------- REQUIRED
JWT_SECRET_KEY=
POSTGRES_PASSWORD=

# ---------------------------------------------------------------- AI answers (assistant)
# https://aistudio.google.com/app/apikey. Without it the assistant shows retrieved sources only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------- Public URL / hosts
# The URL users open. Used for password-reset links and CORS.
FRONTEND_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080
# Comma-separated hostnames the API answers to (e.g. medicore.example.com). "*" disables the check.
ALLOWED_HOSTS=*
WEB_PORT=8080

# ---------------------------------------------------------------- Who runs this service (shown on Help, Privacy, Terms)
# Strongly recommended before launch. Left empty, those pages simply do not name anyone.
OPERATOR_NAME=
SUPPORT_EMAIL=

# ---------------------------------------------------------------- Password-reset email (recommended)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---------------------------------------------------------------- Tuning (optional)
POSTGRES_USER=medicore
POSTGRES_DB=medicore
WEB_CONCURRENCY=2
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
LOG_LEVEL=INFO
ENABLE_DOCS=false
APP_VERSION=1.0.0
# Identify your deployment to OpenStreetMap (their usage policy). Use a real URL or email, never a placeholder
# such as example.com, which Nominatim rejects with 403.
OSM_USER_AGENT=MediCoreAI/1.0 (educational project)

# ---------------------------------------------------------------- Optional knowledge sources
# Free key from https://developer.api.nhs.uk. Used when you rebuild the library (python -m src.rag_ingestion.build_index).
NHS_API_KEY=
