# ---------- Backend ----------
APP_ENV=development
# 64+ random chars. Generate: python -c "import secrets;print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# PostgreSQL (docker-compose) — or sqlite:///./medicore.db for local dev without Docker
DATABASE_URL=postgresql+psycopg://medicore:medicore@localhost:5432/medicore
POSTGRES_USER=medicore
POSTGRES_PASSWORD=medicore
POSTGRES_DB=medicore

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Artifacts
MODELS_DIR=../models
DATA_DIR=../data

# Uploads
MAX_UPLOAD_MB=10

# ---------- Generative AI ----------
# https://aistudio.google.com/app/apikey  — leave blank to run retrieval-only mode
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---------- Locator ----------
# OSM endpoints (no key). Please respect their usage policies.
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Comma-separated Overpass endpoints, tried in order (public instances are sometimes overloaded)
OVERPASS_URL=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter
# Contact string sent in the User-Agent, required by the Nominatim usage policy
OSM_USER_AGENT=MediCoreAI/0.1 (educational project)

# ---------- Frontend (Vite) ----------
# Leave empty: the SPA calls same-origin /api (Vite proxy in dev, nginx in production).
# Set only when the API is on a different origin (e.g. Vercel + Render).
VITE_API_BASE_URL=

# ---------- Optional knowledge sources ----------
# Free key from https://developer.api.nhs.uk : enables the NHS source in `python -m src.rag_ingestion.build_index`
NHS_API_KEY=
